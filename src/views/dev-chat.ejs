<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PIXRA AI dev chat</title>
<style>
  :root { --bg:#efeae2; --me:#d9fdd3; --bot:#fff; --ink:#111b21; --muted:#667781; --brand:#008069; }
  * { box-sizing: border-box; }
  body { margin:0; font:15px/1.4 system-ui, -apple-system, "Segoe UI", sans-serif; color:var(--ink); background:#d1d7db; }
  .app { max-width:720px; margin:0 auto; height:100vh; display:flex; flex-direction:column; background:var(--bg); }
  header { background:var(--brand); color:#fff; padding:10px 16px; display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
  header b { font-size:17px; margin-right:auto; }
  header input { width:150px; padding:5px 8px; border-radius:6px; border:0; }
  header button { background:#fff; color:var(--brand); border:0; border-radius:6px; padding:5px 10px; cursor:pointer; }
  .state { font-size:12px; color:#e1f5ef; width:100%; }
  #log { flex:1; overflow-y:auto; padding:16px; display:flex; flex-direction:column; gap:6px; }
  .msg { max-width:78%; padding:7px 10px; border-radius:8px; white-space:pre-wrap; word-wrap:break-word; box-shadow:0 1px 1px rgba(0,0,0,.08); }
  .in { align-self:flex-end; background:var(--me); }
  .out { align-self:flex-start; background:var(--bot); }
  .msg img { display:block; max-width:100%; max-height:420px; border-radius:6px; margin-bottom:4px; cursor:zoom-in; }
  .msg audio { display:block; margin-bottom:4px; }
  .meta { font-size:11px; color:var(--muted); text-align:right; margin-top:2px; }
  form { display:flex; gap:8px; padding:10px; background:#f0f2f5; align-items:center; }
  #text { flex:1; padding:10px 12px; border-radius:20px; border:0; font:inherit; }
  .btn { border:0; background:var(--brand); color:#fff; border-radius:20px; padding:9px 14px; cursor:pointer; font:inherit; }
  label.btn { background:#54656f; }
  input[type=file] { display:none; }
  .busy { opacity:.6; pointer-events:none; }
  .hint { font-size:12px; color:var(--muted); padding:0 12px 8px; background:#f0f2f5; }
</style>
</head>
<body>
<div class="app">
  <header>
    <b>PIXRA AI · dev chat</b>
    <span>Phone</span><input id="phone" value="919999900001" aria-label="Simulated phone number">
    <button id="newPhone" type="button" title="Use a fresh simulated number">New customer</button>
    <div class="state" id="state"></div>
  </header>
  <div id="log" aria-live="polite"></div>
  <form id="form">
    <label class="btn" title="Send an image (add a caption like 'this is my logo')">Image<input type="file" id="img" accept="image/*"></label>
    <label class="btn" title="Send a voice note (any audio file)">Voice<input type="file" id="aud" accept="audio/*"></label>
    <input id="text" placeholder="Type a message (or a caption for an image)" autocomplete="off">
    <button class="btn" type="submit">Send</button>
  </form>
  <div class="hint">Simulated customers are never messaged on WhatsApp. Type RESTART to begin a new poster.</div>
</div>
<script>
const $ = (id) => document.getElementById(id);
const log = $('log'), phoneEl = $('phone');
let lastSig = '';

try { const p = localStorage.getItem('pixra-dev-phone'); if (p) phoneEl.value = p; } catch {}
phoneEl.addEventListener('change', () => { try { localStorage.setItem('pixra-dev-phone', phoneEl.value); } catch {} lastSig=''; refresh(); });
$('newPhone').onclick = () => { phoneEl.value = '9199' + String(Date.now()).slice(-8); phoneEl.dispatchEvent(new Event('change')); };

function esc(s) { return String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c])); }

function render(data) {
  const msgs = data.messages || [];
  const sig = msgs.length + ':' + (msgs[msgs.length-1]?.id || '');
  const c = data.conversation;
  $('state').textContent = c ? `conversation: ${c.state} · fields: ${Object.keys(c.collected_fields||{}).filter(k => c.collected_fields[k]).join(', ') || '-'}` : 'no conversation yet';
  if (sig === lastSig) return;
  lastSig = sig;
  const atBottom = log.scrollHeight - log.scrollTop - log.clientHeight < 80;
  log.innerHTML = msgs.map((m) => {
    let media = '';
    if (m.media_url && m.type === 'image') media = `<a href="${esc(m.media_url)}" target="_blank"><img src="${esc(m.media_url)}" alt="image"></a>`;
    if (m.media_url && m.type === 'audio') media = `<audio controls src="${esc(m.media_url)}"></audio>`;
    const label = m.type === 'audio' ? '🎤 ' : '';
    return `<div class="msg ${m.direction}">${media}${m.content ? label + esc(m.content) : ''}<div class="meta">${new Date(m.created_at).toLocaleTimeString()}</div></div>`;
  }).join('');
  if (atBottom || msgs.length < 3) log.scrollTop = log.scrollHeight;
}

async function refresh() {
  try {
    const r = await fetch('/dev/messages?phone=' + encodeURIComponent(phoneEl.value));
    render(await r.json());
  } catch {}
}

const toB64 = (file) => new Promise((ok, fail) => {
  const fr = new FileReader();
  fr.onload = () => ok(String(fr.result).split(',')[1]);
  fr.onerror = fail;
  fr.readAsDataURL(file);
});

async function send(body) {
  const form = $('form');
  form.classList.add('busy');
  try {
    const r = await fetch('/dev/simulate', { method:'POST', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify({ phone: phoneEl.value, wait: false, ...body }) });
    if (!r.ok) alert((await r.json()).error || 'send failed');
  } finally {
    form.classList.remove('busy');
    setTimeout(refresh, 300);
  }
}

$('form').onsubmit = (e) => {
  e.preventDefault();
  const text = $('text').value.trim();
  if (!text) return;
  $('text').value = '';
  send({ text });
};
$('img').onchange = async (e) => {
  const f = e.target.files[0]; if (!f) return;
  const caption = $('text').value.trim(); $('text').value = '';
  await send({ image_base64: await toB64(f), mime: f.type || 'image/png', text: caption });
  e.target.value = '';
};
$('aud').onchange = async (e) => {
  const f = e.target.files[0]; if (!f) return;
  await send({ audio_base64: await toB64(f), mime: f.type || 'audio/ogg' });
  e.target.value = '';
};

refresh();
setInterval(refresh, 1500);
</script>
</body>
</html>
