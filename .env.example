# =====================================================================
# PIXRA AI environment variables
# Copy to .env (local) or set in Render -> Environment. Never commit .env.
# See MANUAL_STEPS.md for where each value comes from.
# Check your values any time with:  npm run doctor   (production: npm run doctor -- --prod)
# =====================================================================

# ---------- App ----------
# Port to listen on. Render sets this automatically.
PORT=3000
# "production" turns on every startup safety check (Render sets this via render.yaml).
# Production is also assumed when MOCK_MODE=false and DEV_MODE=false.
NODE_ENV=development
# Public https URL of this app, no trailing slash (local: your cloudflared tunnel URL).
# On Render leave empty: RENDER_EXTERNAL_URL is used automatically.
PUBLIC_BASE_URL=
# true = every external service is replaced by a mock (no keys needed). Not allowed in production.
MOCK_MODE=true
# true = enables the /dev simulator, and services with missing keys fall back to mocks.
# The DATABASE never falls back: with MOCK_MODE=false, Supabase is required or the app exits.
# Must be false in production.
DEV_MODE=true
# debug | info | warn | error   (phone numbers are masked and secrets redacted in every log line)
LOG_LEVEL=info
# How many hours after brief confirmation the poster is due.
DELIVERY_HOURS=3
# Timezone used for times shown to customers and in the portal.
DISPLAY_TIMEZONE=Asia/Kolkata
# Optional: path to a system ffmpeg. Empty = use the bundled ffmpeg-static binary.
FFMPEG_PATH=

# ---------- Local mock storage (used only when MOCK_MODE=true) ----------
# Folder for the JSON "database" file.
DATA_DIR=data
# Folder for uploaded/generated images, served at /uploads.
UPLOADS_DIR=uploads

# ---------- WhatsApp Cloud API (Meta) ----------
# true = customers chat on WhatsApp (needs every WHATSAPP_* value below).
# false = WEB DEMO MODE: no WhatsApp values needed; customers chat at /demo (needs DEMO_PASSWORD),
#         /webhook answers 503, approved posters are delivered into the /demo chat.
# Switching to true later needs no code change: WhatsApp customers are then answered on WhatsApp.
WHATSAPP_ENABLED=true
# Permanent System User access token (or the 24h temporary token for a quick test).
WHATSAPP_TOKEN=
# "Phone number ID" of the test number (WhatsApp -> API Setup). Not the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=
# Any random string you invent; paste the same value into Meta's webhook "Verify token" field.
WHATSAPP_VERIFY_TOKEN=
# App secret (App settings -> Basic -> App secret). REQUIRED: every webhook POST must carry a valid
# X-Hub-Signature-256, otherwise it is rejected with 401.
WHATSAPP_APP_SECRET=
# Dev-only escape hatch: true skips the webhook signature check, but ONLY when MOCK_MODE or
# DEV_MODE is true. Ignored in production. Leave false unless you know why you need it.
WEBHOOK_SKIP_SIGNATURE=false
# Graph API version used for all WhatsApp calls.
GRAPH_API_VERSION=v21.0

# ---------- Telegram (third customer channel) ----------
# true = customers can order posters by chatting with your Telegram bot.
TELEGRAM_ENABLED=false
# Bot token from @BotFather (/newbot). SECRET - never commit or paste it anywhere public.
TELEGRAM_BOT_TOKEN=
# Random secret (32-256 chars of A-Z a-z 0-9 _ -). Telegram sends it in the
# X-Telegram-Bot-Api-Secret-Token header; anything else is rejected with 401.
# Must be the SAME value locally and on Render (npm run telegram:set-webhook uses it).
TELEGRAM_WEBHOOK_SECRET=
# Local development: true = long polling (getUpdates), no public URL/tunnel needed.
# Default = DEV_MODE. Ignored in production (the webhook is used there).
TELEGRAM_POLLING=true
# Bot API base URL (only change for a self-hosted Bot API server).
TELEGRAM_API_BASE=https://api.telegram.org

# ---------- Google Gemini (AI Studio, free tier) ----------
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model for intake, briefs, prompts and vision QA. Any free Flash model works.
# `npm run doctor` lists the models your key can use and suggests one.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional second model, used when GEMINI_MODEL is "not found" or still rate-limited (429) after retries.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Gemini REST API version (path segment of generativelanguage.googleapis.com).
GEMINI_API_VERSION=v1beta

# ---------- Cloudflare Workers AI (free tier) ----------
# Account ID (Cloudflare dashboard -> Workers & Pages -> right sidebar, or the URL).
CF_ACCOUNT_ID=
# API token from the "Workers AI" template.
CF_API_TOKEN=
# Text-to-image model (backgrounds only, never text).
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Diffusion steps for FLUX schnell (1-8). More = slightly better, uses more of the free daily quota.
CF_IMAGE_STEPS=4
# Speech-to-text model for voice notes. If it rejects a WhatsApp OGG file, the app converts it
# to WAV with ffmpeg and retries once. @cf/openai/whisper also works.
CF_WHISPER_MODEL=@cf/openai/whisper-large-v3-turbo

# ---------- Background image provider ----------
# cloudflare  = every poster background from Cloudflare Workers AI (FLUX schnell, free daily allowance)
# huggingface = every background from Hugging Face Inference Providers (uses HF credits; Cloudflare as fallback)
# compare     = poster option 1 from Hugging Face, option 2 from Cloudflare (side-by-side quality comparison)
IMAGE_PROVIDER=cloudflare
# true = if Hugging Face fails (out of credits 402, quota 429, auth 401/403, model gone 404/410, timeout)
# the background is generated with Cloudflare instead and the reason is shown in the admin portal.
IMAGE_FALLBACK_ENABLED=true

# ---------- Hugging Face Inference Providers (optional) ----------
# Token from https://huggingface.co/settings/tokens - fine-grained with "Make calls to Inference Providers".
# Empty = Hugging Face not configured; everything uses Cloudflare. SECRET - never commit or log it.
# FREE accounts include no monthly credits (purchase needed); PRO includes $2.00/month. Switching to a
# PRO token is just replacing this value (and HF_BILL_TO if the credits belong to an organization).
HF_TOKEN=
# Text-to-image model on the Hub (must be served by an Inference Provider).
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# "auto" = first provider in your https://hf.co/settings/inference-providers order, or a specific one
# (e.g. nscale, fal-ai, wavespeed - those currently serve FLUX.1-schnell).
HF_INFERENCE_PROVIDER=auto
# Optional organization name to bill (sends X-HF-Bill-To), e.g. when PRO/Team credits are under an org.
HF_BILL_TO=
# Diffusion steps for Hugging Face (FLUX.1-schnell is designed for 1-4).
HF_IMAGE_STEPS=4
# Give up on Hugging Face after this many milliseconds and use Cloudflare.
HF_TIMEOUT_MS=90000

# ---------- Supabase (Postgres + Storage) ----------
# Project URL, e.g. https://abcdefgh.supabase.co (Project Settings -> Data API)
SUPABASE_URL=
# service_role secret key. SERVER ONLY - never put it in browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Public storage bucket name (created by schema.sql).
SUPABASE_BUCKET=posters

# ---------- Admin portal ----------
# Password for /admin login. Production refuses to start unless it is >= 12 characters and
# not a common/default password.
ADMIN_PASSWORD=
# Random string (>= 32 characters) used to sign the session cookie. Render generates one.
SESSION_SECRET=
# Failed admin login attempts allowed per IP per 15 minutes.
ADMIN_LOGIN_MAX_ATTEMPTS=5

# ---------- Customer web demo chat (/demo) ----------
# Password customers type to use the /demo chat. Required when WHATSAPP_ENABLED=false in production:
# >= 12 characters, not a common password, and different from ADMIN_PASSWORD. Empty = /demo disabled.
DEMO_PASSWORD=
# Max messages/uploads per IP per 10 minutes in the /demo chat (protects the free-tier AI quotas).
DEMO_RATE_LIMIT_PER_10MIN=40

# ---------- Limits / demo ----------
# Max webhook requests per minute per IP (Meta sends from several IPs; keep generous).
WEBHOOK_RATE_LIMIT_PER_MIN=600
# Optional comma-separated phone numbers (digits, with country code) that "Send test poster" in the
# admin portal may send to, e.g. 919876543210,919812345678. Empty = any number may be entered.
DEMO_TEST_NUMBERS=
